{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/caveman-hard-gate.sh",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "./hooks/orchestrator-job-pickup.sh",
        "loop_limit": 3
      }
    ],
    "afterShellExecution": [
      {
        "command": "./hooks/orchestrator-after-engine.sh",
        "matcher": "run-engine"
      }
    ]
  }
}
