{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence/test-report@1.0.0",
  "title": "TestReportEvidence",
  "type": "object",
  "required": ["kind", "metadata", "spec"],
  "properties": {
    "kind": { "const": "Evidence" },
    "metadata": {
      "type": "object",
      "required": ["node_id", "run_id", "provider_id", "capability"],
      "properties": {
        "node_id": { "type": "string" },
        "run_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "capability": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["status", "verdict", "checks"],
      "properties": {
        "status": { "enum": ["complete", "partial", "failed"] },
        "verdict": { "enum": ["passed", "rejected", "conditional", null] },
        "checks": { "type": "array" },
        "duration_ms": { "type": "number" }
      }
    }
  }
}
