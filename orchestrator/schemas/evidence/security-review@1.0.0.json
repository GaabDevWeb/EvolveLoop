{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence/security-review@1.0.0",
  "title": "SecurityReviewEvidence",
  "type": "object",
  "required": ["kind", "metadata", "spec"],
  "properties": {
    "kind": { "const": "Evidence" },
    "metadata": {
      "type": "object",
      "required": ["node_id", "run_id", "provider_id", "capability"],
      "properties": {
        "node_id": { "type": "string" },
        "run_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "capability": { "const": "security-review" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["status", "verdict", "checks"],
      "properties": {
        "status": { "enum": ["complete", "partial", "failed"] },
        "verdict": { "enum": ["passed", "rejected", "conditional", null] },
        "checks": { "type": "array" },
        "security_summary": {
          "type": "object",
          "properties": {
            "executive": { "enum": ["SEGURO PARA RELEASE", "BLOQUEADO - RISCO DETECTADO"] },
            "critical_count": { "type": "number" },
            "high_count": { "type": "number" },
            "gate_phase_5": { "enum": ["LIBERADO", "BLOQUEADO"] }
          }
        }
      }
    }
  }
}
