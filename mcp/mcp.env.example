# Copiar para ~/.cursor/mcp.env ou exportar no shell antes de abrir o Cursor.
# O instalador substitui placeholders em ~/.cursor/mcp.json com estes valores.

# GitHub Personal Access Token (MCP GitHub / Copilot MCP)
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firecrawl API key — https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pasta que o MCP filesystem pode ler/escrever (absoluto)
FILESYSTEM_ROOT=/home/SEU_USER/Documentos

# Opcionais (auth OAuth no browser na 1ª utilização)
# Sentry: abrir Settings → MCP → Authenticate
# Linear: autenticar via mcp-remote no primeiro uso
# Railway: autenticar no browser
# Figma: instalar plugin Cursor "Figma" (não entra neste mcp.json)
